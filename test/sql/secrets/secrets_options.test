# name: test/sql/secrets/secrets_options.test
# description: OPTIONS secret key passes arbitrary MongoDB URI options through to the driver (issue #61)
# group: [secrets]

require mongo

require-env MONGODB_TEST_DATABASE_AVAILABLE

# Valid options are accepted at secret creation time
statement ok
CREATE SECRET mongo_opts_secret (
    TYPE mongo,
    HOST 'localhost',
    PORT '27017',
    DATABASE 'duckdb_mongo_test',
    OPTIONS 'readPreference=secondaryPreferred&maxPoolSize=10'
);

query I
SELECT COUNT(*) FROM duckdb_secrets() WHERE name = 'mongo_opts_secret';
----
1

# mongo_scan with a secret name applies the options (connection succeeds)
query I
SELECT COUNT(*) > 0 FROM mongo_scan('mongo_opts_secret', 'duckdb_mongo_test', 'users');
----
true

# ATTACH with the same secret also works
statement ok
ATTACH '' AS mongo_opts_db (TYPE mongo, SECRET 'mongo_opts_secret');

query I
SELECT COUNT(*) > 0 FROM mongo_opts_db.duckdb_mongo_test.users;
----
true

statement ok
DETACH mongo_opts_db;

# ATTACH path options merge with secret options
statement ok
ATTACH 'options=appName=duckdb_mongo_test' AS mongo_opts_db2 (TYPE mongo, SECRET 'mongo_opts_secret');

query I
SELECT COUNT(*) > 0 FROM mongo_opts_db2.duckdb_mongo_test.users;
----
true

statement ok
DETACH mongo_opts_db2;

# Prove the options reach the driver: an invalid readPreference mode is rejected by the URI parser
statement ok
CREATE SECRET mongo_bad_opts_secret (
    TYPE mongo,
    HOST 'localhost',
    PORT '27017',
    DATABASE 'duckdb_mongo_test',
    OPTIONS 'readPreference=bogus'
);

statement error
SELECT COUNT(*) FROM mongo_scan('mongo_bad_opts_secret', 'duckdb_mongo_test', 'users');
----
readPreference

# ATTACH connects lazily, so the invalid option surfaces on first use
statement ok
ATTACH '' AS mongo_bad_opts_db (TYPE mongo, SECRET 'mongo_bad_opts_secret');

statement error
SELECT COUNT(*) FROM mongo_bad_opts_db.duckdb_mongo_test.users;
----
readPreference

statement ok
DETACH mongo_bad_opts_db;

statement ok
DROP SECRET mongo_opts_secret;

statement ok
DROP SECRET mongo_bad_opts_secret;
