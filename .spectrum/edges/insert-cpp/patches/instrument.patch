--- /dev/null
+++ b/src/conformance_trace.hpp
@@ -0,0 +1,57 @@
+// ---- conformance tracing (applied only to a throwaway build) ----
+// Header-only: every seam file #includes it, so no translation unit
+// is added to any target and no link step changes. One writer behind
+// a function-local static mutex gives every thread's events one
+// replayable total order. The file is opened on the first emit, from
+// the path $SPECTRUM_TRACE holds, so nothing has to be called before the
+// code under test runs and a test suite drives it untouched.
+#pragma once
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+inline std::string conformance_quote(const std::string &s) {
+    std::string out = "\"";
+    for (char c : s) {
+        switch (c) {
+            case '"': out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            default: out += c;
+        }
+    }
+    out += "\"";
+    return out;
+}
+
+inline std::string conformance_set(const std::vector<std::string> &xs) {
+    std::string out;
+    for (size_t i = 0; i < xs.size(); i++) {
+        if (i > 0) out += ",";
+        out += conformance_quote(xs[i]);
+    }
+    return out;
+}
+
+inline void conformance_emit(const std::string &event) {
+    static std::mutex conformance_mutex;
+    static std::ofstream conformance_out;
+    std::lock_guard<std::mutex> lock(conformance_mutex);
+    if (!conformance_out.is_open()) {
+        const char *path = std::getenv("SPECTRUM_TRACE");
+        if (path == nullptr) {
+            throw std::runtime_error(
+                "SPECTRUM_TRACE is unset: it names the file this run's trace "
+                "is written to, and the conformance runner sets it from "
+                "the manifest's `run_env`");
+        }
+        conformance_out.open(path);
+    }
+    conformance_out << event << "\n";
+    conformance_out.flush();
+}
